# Copy to .env and edit. Never commit the real file.
#
# ---------------------------------------------------------------------------
# Web console
# ---------------------------------------------------------------------------
BTC5M_WEB_USER=admin

# Generate the hash on the host, so the plaintext never reaches a config file:
#   python -c "from web.auth import hash_password; print(hash_password('your-password'))"
BTC5M_WEB_PASSWORD_HASH=

# Development shortcut only — hashed at boot, and it lands in `docker inspect`,
# shell history and process listings. Use BTC5M_WEB_PASSWORD_HASH in production.
# BTC5M_WEB_PASSWORD=

# Session signing key. Leave empty and one is generated per process, which logs
# everyone out on restart. Set it to persist sessions:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
BTC5M_WEB_SECRET=

# 1 = watch only (default). 0 = the console may start, stop and switch profiles.
# The kill switch stays available either way.
BTC5M_WEB_READONLY=1

# 1 = served over TLS: Secure cookies and HSTS. Set to 0 ONLY for local http://,
# otherwise the browser withholds the CSRF cookie and login cannot complete.
BTC5M_WEB_HTTPS=1

# Comma-separated Host allow-list. Leave as * only behind a trusted proxy.
BTC5M_WEB_ALLOWED_HOSTS=*

# Set to 1 only when a reverse proxy you control sets X-Forwarded-For.
BTC5M_WEB_TRUST_PROXY=0

BTC5M_WEB_SESSION_IDLE_MIN=30
BTC5M_WEB_SESSION_MAX_HOURS=8
BTC5M_WEB_LOGIN_MAX_ATTEMPTS=5
BTC5M_WEB_LOGIN_LOCKOUT_SEC=300
BTC5M_WEB_API_RATE_PER_MIN=240

# ---------------------------------------------------------------------------
# Session defaults
# ---------------------------------------------------------------------------
BTC5M_WEB_PROFILE=demo
BTC5M_WEB_SOURCE=simulated     # simulated | polymarket
BTC5M_WEB_EQUITY=100
BTC5M_DB=/data/btc5m.db
BTC5M_CONFIG=/app/config/btc_5m_profiles.yaml

# ---------------------------------------------------------------------------
# Live trading (only needed for `btc5m ... --execute`)
# ---------------------------------------------------------------------------
# Checkout containing src/live/pm_live_trade_runner.py
# BTC5M_REPO=/path/to/pm-hl-conservative-plus-repo
# BTC5M_PYTHON=/path/to/pm-hl-conservative-plus-repo/.venv/bin/python
#
# Polymarket credentials are read from the environment by that runner. Keep them
# in a separate file with 0600 permissions; this project never reads or logs them.
# PM_PRIVATE_KEY=
# PM_API_KEY=
# PM_API_SECRET=
# PM_API_PASSPHRASE=
# PM_FUNDER=
