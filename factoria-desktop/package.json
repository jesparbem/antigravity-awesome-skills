{
  "name": "factoria-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "FactorIA Desktop — Tu IA. En tu PC.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "node scripts/e2e.mjs",
    "lint": "eslint src --ext .ts,.svelte",
    "format": "prettier --write \"src/**/*.{ts,svelte,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,svelte,css}\"",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.2.0",
    "dompurify": "^3.2.4",
    "marked": "^15.0.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tailwindcss/vite": "^4.0.6",
    "@tauri-apps/cli": "^2.2.7",
    "jsdom": "^26.0.0",
    "prettier": "^3.5.1",
    "prettier-plugin-svelte": "^3.3.3",
    "svelte": "^5.20.1",
    "svelte-check": "^4.1.4",
    "tailwindcss": "^4.0.6",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}